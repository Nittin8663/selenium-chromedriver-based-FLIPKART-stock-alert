from selenium import webdriver
from selenium.webdriver.common.by import By
import time
from datetime import datetime
import pywhatkit

# Chrome user data path for maintaining login session
chrome_data_path = "D:\\UserData"  # Example: D:\\UserData

opti = webdriver.ChromeOptions()
opti.add_argument(r"--user-data-dir=" + chrome_data_path)
opti.add_argument(r'--profile-directory=Profile 3')  # Change profile if needed
opti.add_argument("--start-minimized")
opti.binary_location = "D:\\Chrome\\Application\\chrome.exe"  # Chrome executable location

browser = webdriver.Chrome(options=opti)

multiple_products = [
    "https://www.flipkart.com/apple-2024-ipad-air-m2-512-gb-rom-13-0-inch-wi-fi-only-purple/p/itm41ef927dd4161?pid=TABHYZEYZEYHFX2M",
    "https://www.flipkart.com/apple-2024-ipad-air-m2-512-gb-rom-11-0-inch-wi-fi-5g-purple/p/itm29a8405f8bfe1?pid=TABHYZDZKN2ZR2NG",
    "https://www.flipkart.com/apple-2024-ipad-air-m2-1-tb-rom-11-0-inch-wi-fi-only-space-grey/p/itmbb4e4c243cdb9?pid=TABHYZDZTABQTUUG",
    "https://www.flipkart.com/apple-2024-ipad-pro-m4-1-tb-rom-13-0-inch-wi-fi-5g-space-black/p/itmd0cd6fc04c38e?pid=TABHYZEYC89RWCPN"
]
single_product = ""  # Enter single product link here

delay = 3  # Delay in seconds
i = 0
iterMod = 100  # Log every 100 refreshes
mpi = 0
flag = 0
msgurl = ""

while True:
    if i % 2 == 0:
        # Multi product check
        browser.get(multiple_products[mpi])
        mpi += 1
        flag = 1
        if mpi == len(multiple_products):
            mpi = 0
        msgurl = multiple_products[mpi]
    else:
        browser.get(single_product)
        flag = 2
        msgurl = single_product

    time.sleep(delay)
    inHT = browser.find_element(By.TAG_NAME, 'body').get_attribute('innerHTML')

    # Flipkart "Buy Now" means in stock
    if 'Buy Now' in inHT:
        msg = ""
        if flag == 1:
            msg = "MULTIPLE PRODUCTS IN STOCK "
        elif flag == 2:
            msg = "SINGLE PRODUCT IN STOCK "
        msg += msgurl
        pywhatkit.sendwhatmsg_instantly("+919999999999", msg)  # Change to your WhatsApp number
        print(datetime.now(), ": IN STOCK. SENDING MESSAGE.\n")
        if 'Login' in inHT:
            pywhatkit.sendwhatmsg_instantly("+919999999999", "HAVE TO RELOG NOW")  # Change to your WhatsApp number
        else:
            try:
                browser.find_element(By.XPATH, "//button[text() = 'Buy Now']").click()
                time.sleep(delay)
                browser.find_element(By.XPATH, "//button[text() = 'Deliver Here']").click()
                time.sleep(delay)
                browser.find_element(By.XPATH, "//button[text() = 'CONTINUE']").click()
                time.sleep(delay)
                browser.find_element(By.XPATH, "//button[text() = 'Accept & Continue']").click()
            except Exception as e:
                print("Error during auto checkout:", e)
        while True:
            pywhatkit.sendwhatmsg_instantly("+919999999999", msg)  # Change to your WhatsApp number
            time.sleep(delay * 5)

    elif i % iterMod == 0:
        print(datetime.now(), ": Not in stock. Refreshing.\n")
    i = i + 1
